{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile in AI Employee Office",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User identifier matching auth.uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "description": "User role in office (e.g., Director, Manager)",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp in ISO or server format",
          "maxLength": 64
        }
      },
      "required": ["id", "email", "displayName"]
    },
    "Task": {
      "title": "Task",
      "description": "Virtual office task processed by AI agents",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Task title or headline",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "description": "Detailed instructions and context for AI agents",
          "maxLength": 5000
        },
        "priority": {
          "type": "string",
          "description": "Task priority level",
          "enum": ["low", "medium", "high", "urgent"]
        },
        "category": {
          "type": "string",
          "description": "Task category",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Current execution status",
          "enum": ["pending", "in_progress", "completed", "failed"]
        },
        "provider": {
          "type": "string",
          "description": "AI provider used (gemini, groq, openrouter, fallback)",
          "maxLength": 64
        },
        "assignedAgents": {
          "type": "array",
          "description": "List of agent IDs collaborating on this task"
        },
        "steps": {
          "type": "array",
          "description": "Step-by-step progress items executed by agents"
        },
        "finalReport": {
          "type": "string",
          "description": "Comprehensive report generated by agents",
          "maxLength": 50000
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO string",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO string",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title", "description", "status"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Virtual 3D employee profile and operational configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique agent identifier",
          "maxLength": 64
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID who configured or customized the agent",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Employee agent full name",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Job title or position (e.g. Chief Strategist, Senior Researcher)",
          "maxLength": 128
        },
        "department": {
          "type": "string",
          "description": "Office department (Strategy, Research, Engineering, Creative, QA)",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Agent activity status (idle, working, collaborating, offline)",
          "enum": ["idle", "working", "collaborating", "offline"]
        },
        "currentTaskId": {
          "type": "string",
          "description": "ID of task currently being processed",
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "description": "Underlying AI model preferred (e.g. gemini-2.5-flash)",
          "maxLength": 64
        },
        "systemPrompt": {
          "type": "string",
          "description": "Agent persona instructions and specialization",
          "maxLength": 4000
        },
        "avatar": {
          "type": "string",
          "description": "3D character visual key or emoji descriptor",
          "maxLength": 128
        },
        "color": {
          "type": "string",
          "description": "Distinctive color accent theme",
          "maxLength": 32
        },
        "tasksCompleted": {
          "type": "number",
          "description": "Count of successfully finished assignments"
        }
      },
      "required": ["id", "userId", "name", "role", "department", "status"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Real-time activity log of virtual office agents",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique activity entry ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Associated user UID",
          "maxLength": 128
        },
        "agentId": {
          "type": "string",
          "description": "Agent responsible for the action",
          "maxLength": 64
        },
        "agentName": {
          "type": "string",
          "description": "Name of the agent",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "description": "Type of event (task_created, analyzing, writing_report, review, completed)",
          "maxLength": 64
        },
        "details": {
          "type": "string",
          "description": "Brief narrative of what the employee just did",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "description": "Activity timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "agentId", "agentName", "action", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection isolating individual account settings"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of tasks and multi-agent reports owned by users"
    },
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "Collection of employee agents configured for the user's virtual office"
    },
    "/activity/{activityId}": {
      "schema": "Activity",
      "description": "Log feed of office events and agent communications"
    }
  }
}
